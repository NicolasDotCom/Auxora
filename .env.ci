# ============================================
# ENTORNO PARA CI / GITHUB ACTIONS
# ============================================
# Sobrescribe los valores de .env.example, que está pensado
# para desarrollo local con Redis y SQLite.
# Este archivo se usa SOLO en CI donde NO hay Redis.

APP_NAME="Tickets-App"
APP_ENV=testing
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_LEVEL=debug

# === BASE DE DATOS (servicio MySQL en CI) ===
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ticket_tes_testing
DB_USERNAME=root
DB_PASSWORD=root

# === CACHE / SESIÓN / COLA (sin Redis en CI) ===
CACHE_STORE=array
SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
QUEUE_CONNECTION=sync

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# === MAIL (no enviar nada durante tests) ===
MAIL_MAILER=array
MAIL_FROM_ADDRESS="noreply@auxora.homelabvps.dev"
MAIL_FROM_NAME="${APP_NAME}"

# === REDIS (no se usa en CI pero evitamos errores de boot) ===
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null

# === S3 / STORAGE (vacío para tests) ===
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

BCRYPT_ROUNDS=4

VITE_APP_NAME="${APP_NAME}"