APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# ============================================
# DEMO MODE (portafolio / sandbox)
# ============================================
# Cuando APP_DEMO=true:
#  - La landing /welcome expone 1-click login por rol
#  - Se muestra un banner persistente "Entorno demo"
#  - El registro público está habilitado (con rate limit)
#  - Los nuevos usuarios reciben rol "customer"
#  - Cron demo:reset limpia la BD cada noche
# APP_DEMO=false
# APP_DEMO_BANNER="Entorno demo — los datos se reinician cada noche a las 03:00 UTC"
# APP_DEMO_RESET_HOUR=3
# APP_DEMO_PUBLIC_REGISTRATION=true
# APP_DEMO_MAX_TICKETS_PER_USER=5

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# API performance observability thresholds (milliseconds)
API_SLOW_REQUEST_MS=800
API_SLOW_DB_MS=400

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=
DB_MIN_CONNECTIONS=5
DB_MAX_CONNECTIONS=100

# === SESIÓN ===
# Para DESARROLLO LOCAL sin Redis, usa:
SESSION_DRIVER=array
# Para PRODUCCIÓN con Redis disponible, usa:
# SESSION_DRIVER=redis
# SESSION_CONNECTION=cache
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=auxora_

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ============================================
# EMAIL CONFIGURATION
# ============================================
# Opción 1: Resend (Recomendado para producción)
MAIL_MAILER=resend
RESEND_KEY=your_resend_api_key_here
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Opción 2: LOG (Solo para desarrollo local)
# MAIL_MAILER=log

# Opción 3: SMTP (Gmail, Mailtrap, etc.)
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your_email@gmail.com
# MAIL_PASSWORD=your_app_password_here
# MAIL_ENCRYPTION=tls

# ============================================
# S3 / CLOUD STORAGE CONFIGURATION
# ============================================
# Para producción usa: FILESYSTEM_DISK=s3
# Para local usa: FILESYSTEM_DISK=local

# Amazon S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# DigitalOcean Spaces (usa las mismas variables AWS_*)
# AWS_ACCESS_KEY_ID=tu_spaces_key
# AWS_SECRET_ACCESS_KEY=tu_spaces_secret
# AWS_DEFAULT_REGION=nyc3
# AWS_BUCKET=nombre-de-tu-space
# AWS_ENDPOINT=https://nyc3.digitaloceanspaces.com
# AWS_URL=https://nombre-de-tu-space.nyc3.digitaloceanspaces.com

# Cloudflare R2 (usa las mismas variables AWS_*)
# AWS_ACCESS_KEY_ID=tu_r2_access_key
# AWS_SECRET_ACCESS_KEY=tu_r2_secret
# AWS_DEFAULT_REGION=auto
# AWS_BUCKET=nombre-bucket
# AWS_ENDPOINT=https://account_id.r2.cloudflarestorage.com
# AWS_URL=https://tu-dominio.r2.dev

VITE_APP_NAME="${APP_NAME}"
