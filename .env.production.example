# ============================================
# CONFIGURACIÓN PARA LARAVEL CLOUD (PRODUCCIÓN)
# ============================================
# Copia estas variables a tu panel de Laravel Cloud en:
# Settings → Environment Variables

# ============================================
# APLICACIÓN
# ============================================
APP_NAME="Tickets-App"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://tickets-app-main-dbvpcm.laravel.cloud

# ============================================
# LOCALE (ESPAÑOL)
# ============================================
APP_LOCALE=es
APP_FALLBACK_LOCALE=es

# ============================================
# SESIÓN - CRÍTICO PARA AUTENTICACIÓN
# ============================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# ⚠️ IMPORTANTE: Estas variables son CRÍTICAS para que funcione la autenticación en HTTPS
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# ============================================
# CACHE Y COLA
# ============================================
CACHE_STORE=database
QUEUE_CONNECTION=sync

# ============================================
# CORREO ELECTRÓNICO - RESEND
# ============================================
# ⚠️ IMPORTANTE: Usa Resend para mejor deliverability
# Evita que los correos vayan a spam

# CONFIGURACIÓN DE RESEND (RECOMENDADO para producción) ⭐
# 1. Regístrate gratis en: https://resend.com
# 2. Ve a: https://resend.com/api-keys
# 3. Crea una nueva API Key para PRODUCCIÓN
# 4. Copia la clave (solo se muestra una vez)
# 5. Pégala abajo en RESEND_KEY

MAIL_MAILER=resend
RESEND_KEY=your_production_resend_api_key_here
MAIL_FROM_ADDRESS=auxora.support@gmail.com
MAIL_FROM_NAME="${APP_NAME}"

# 🔐 SEGURIDAD: NO subir la clave real a Git
# 📋 INSTRUCCIONES: Ver archivo EMAIL.md en la raíz del proyecto

# ============================================
# BASE DE DATOS
# ============================================
# Laravel Cloud configura esto automáticamente
# No necesitas agregar DB_* manualmente

# ============================================
# LOGGING
# ============================================
LOG_CHANNEL=stack
LOG_LEVEL=error

# ============================================
# INSTRUCCIONES
# ============================================
# 1. Ve a tu panel de Laravel Cloud
# 2. Settings → Environment Variables
# 3. Agrega TODAS estas variables (especialmente SESSION_*)
# 4. Guarda los cambios
# 5. Laravel Cloud reiniciará automáticamente la aplicación
# 6. Prueba el login nuevamente
#
# NOTA: Las variables SESSION_SECURE_COOKIE, SESSION_HTTP_ONLY y SESSION_SAME_SITE
#       son ESENCIALES para que funcione la autenticación en HTTPS
