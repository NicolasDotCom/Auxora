# ============================================
# CONFIGURACIÓN PARA COOLIFY / VPS (PRODUCCIÓN)
# ============================================
# Copia estas variables al panel de Coolify en:
# Service → Environment Variables
#
# Las credenciales reales (DB, Redis, MinIO, Resend) las genera
# Coolify automáticamente cuando agregas los recursos al Project.
# Aquí solo defines nombres, hosts internos y configuración Laravel.

# ============================================
# APLICACIÓN
# ============================================
APP_NAME="Tickets-App"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://auxora.homelabvps.dev

# ============================================
# LOCALE (ESPAÑOL)
# ============================================
APP_LOCALE=es
APP_FALLBACK_LOCALE=es

# ============================================
# SESIÓN - CRÍTICO PARA AUTENTICACIÓN
# ============================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# ⚠️ IMPORTANTE: Estas variables son CRÍTICAS para que funcione la autenticación en HTTPS
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# ============================================
# CACHE Y COLA
# ============================================
CACHE_STORE=database
QUEUE_CONNECTION=sync

# ============================================
# CORREO ELECTRÓNICO - RESEND
# ============================================
# ⚠️ IMPORTANTE: Usa Resend para mejor deliverability.
# Evita que los correos vayan a spam.

# CONFIGURACIÓN DE RESEND (RECOMENDADO para producción) ⭐
# 1. Regístrate gratis en: https://resend.com
# 2. Ve a: https://resend.com/api-keys
# 3. Crea una nueva API Key para PRODUCCIÓN
# 4. Copia la clave (solo se muestra una vez)
# 5. Pégala abajo en RESEND_KEY

MAIL_MAILER=resend
RESEND_KEY=your_production_resend_api_key_here
MAIL_FROM_ADDRESS=auxora.support@gmail.com
MAIL_FROM_NAME="${APP_NAME}"

# 🔐 SEGURIDAD: NO subir la clave real a Git.
# 📋 INSTRUCCIONES: Ver archivo EMAIL.md en la raíz del proyecto.

# ============================================
# BASE DE DATOS (Coolify expone el servicio MySQL)
# ============================================
# Cuando creas un recurso MySQL en Coolify, las variables se inyectan
# automáticamente como SERVICE_MYSQL_* en otros servicios. Si no, define:
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=tickets
DB_USERNAME=tickets
DB_PASSWORD=secret

# ============================================
# REDIS (servicio Coolify)
# ============================================
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================
# STORAGE
# ============================================
# Opción A: disco local (volumen persistente)
FILESYSTEM_DISK=local

# Opción B: MinIO self-hosted (descomentar y rellenar)
# FILESYSTEM_DISK=s3
# AWS_ACCESS_KEY_ID=minio
# AWS_SECRET_ACCESS_KEY=miniosecret
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=tickets
# AWS_ENDPOINT=http://minio:9000
# AWS_URL=https://auxora.homelabvps.dev
# AWS_USE_PATH_STYLE_ENDPOINT=true

# ============================================
# LOGGING
# ============================================
LOG_CHANNEL=stack
LOG_LEVEL=error

# ============================================
# INSTRUCCIONES
# ============================================
# 1. Entra al panel de Coolify (http://IP_VPS:8000)
# 2. Crea un Project y agrega los recursos:
#    - MySQL 8
#    - Redis 7
#    - (Opcional) MinIO
#    - Application (este repo)
# 3. Service → Environment Variables: pega las variables de este archivo
# 4. Marca RUN_MIGRATIONS=true solo para el primer deploy
# 5. Activa Force HTTPS en el dominio
# 6. Verifica login y revisa los logs
#
# NOTA: Las variables SESSION_SECURE_COOKIE, SESSION_HTTP_ONLY y SESSION_SAME_SITE
#       son ESENCIALES para que funcione la autenticación en HTTPS